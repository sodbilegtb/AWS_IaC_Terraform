# Kopiere diese Datei nach terraform.tfvars und trage eigene Werte ein.
# terraform.tfvars ist per .gitignore ausgeschlossen und gehört nicht ins Repository.

aws_region             = "eu-central-1"
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidr_1a  = "10.0.1.0/24"
public_subnet_cidr_1b  = "10.0.2.0/24"
private_subnet_cidr_1a = "10.0.3.0/24"
private_subnet_cidr_1b = "10.0.4.0/24"

ami_id        = "ami-0c02fb55956c7d316" # Amazon Linux 2, Free Tier
instance_type = "t2.micro"

create_rds        = false
db_instance_class = "db.t3.micro"
db_name           = "mydatabase"
db_username       = "CHANGE_ME"
# db_password NICHT hier eintragen, sondern als Umgebungsvariable setzen:
#   export TF_VAR_db_password='...'

bucket_name = "CHANGE_ME-static-site"
